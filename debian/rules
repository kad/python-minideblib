#!/usr/bin/make -f

export PYBUILD_NAME=minideblib
export PYBUILD_SYSTEM=pyproject
# Keep tests from writing bytecode into the source tree (examples/ is installed).
export PYTHONDONTWRITEBYTECODE=1
# Tests needing the network are skipped; so are tests of the upstream
# repository layout that need git, uv or the CI configuration.
export PYBUILD_TEST_PYTEST=1
export PYBUILD_TEST_ARGS=-p no:cacheprovider -m "not network" \
	--ignore={dir}/tests/test_no_vendor_refs.py \
	--ignore={dir}/tests/test_typing_marker.py \
	--ignore={dir}/tests/test_workflows.py \
	{dir}/tests

%:
	dh $@ --with python3 --buildsystem=pybuild
